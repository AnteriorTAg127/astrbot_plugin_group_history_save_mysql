{
    "mysql_host": {
        "description": "MySQL 主机地址",
        "type": "string",
        "default": "127.0.0.1",
        "hint": "MySQL 服务器的 IP 地址或域名"
    },
    "mysql_port": {
        "description": "MySQL 端口",
        "type": "int",
        "default": 3306,
        "hint": "MySQL 服务端口号"
    },
    "mysql_user": {
        "description": "MySQL 用户名",
        "type": "string",
        "default": "root",
        "hint": "用于连接 MySQL 的用户名"
    },
    "mysql_password": {
        "description": "MySQL 密码",
        "type": "string",
        "default": "",
        "hint": "MySQL 用户对应的密码"
    },
    "mysql_database": {
        "description": "数据库名",
        "type": "string",
        "default": "astrbot_history",
        "hint": "存储聊天记录的数据库名称，需提前创建或确保用户有建库权限"
    },
    "pool_min_size": {
        "description": "连接池最小连接数",
        "type": "int",
        "default": 1,
        "hint": "空闲时保持的最少连接数"
    },
    "pool_max_size": {
        "description": "连接池最大连接数",
        "type": "int",
        "default": 10,
        "hint": "高负载时允许的最大并发连接数"
    },
    "pool_idle_timeout": {
        "description": "空闲连接回收时间（秒）",
        "type": "int",
        "default": 120,
        "hint": "超过此时间未使用的多余连接将被自动关闭"
    },
    "pool_timeout": {
        "description": "获取连接超时（秒）",
        "type": "int",
        "default": 30,
        "hint": "等待可用连接的最大时间"
    }
}
